# ============================================================
# DATABASE
# ============================================================
# Compose service names. For local non-Compose development, override these
# values in a local .env file.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=museum_collection
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
# RABBITMQ
# ============================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============================================================
# AUTH
# ============================================================
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8001

JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SEED_ADMIN_EMAIL=admin@museum.local
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator

# ============================================================
# COLLECTION
# ============================================================
COLLECTION_SERVICE_HOST=0.0.0.0
COLLECTION_SERVICE_PORT=8002
FILE_STORAGE_PATH=./storage
PUBLIC_FRONTEND_URL=http://127.0.0.1:3000

# ============================================================
# CONSERVATION
# ============================================================
CONSERVATION_SERVICE_HOST=0.0.0.0
CONSERVATION_SERVICE_PORT=8003

# ============================================================
# LOAN
# ============================================================
LOAN_SERVICE_HOST=0.0.0.0
LOAN_SERVICE_PORT=8004

# ============================================================
# NOTIFICATION
# ============================================================
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8005

# ============================================================
# AUDIT
# ============================================================
AUDIT_SERVICE_HOST=0.0.0.0
AUDIT_SERVICE_PORT=8006

# ============================================================
# API GATEWAY
# ============================================================
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

AUTH_SERVICE_URL=http://auth-service:8001
COLLECTION_SERVICE_URL=http://collection-service:8002
CONSERVATION_SERVICE_URL=http://conservation-service:8003
LOAN_SERVICE_URL=http://loan-service:8004
NOTIFICATION_SERVICE_URL=http://notification-service:8005
AUDIT_SERVICE_URL=http://audit-service:8006

REQUEST_TIMEOUT_SECONDS=15

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME=Museum Collection Lifecycle Platform
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_GATEWAY_URL=http://api-gateway:8000

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
